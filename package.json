{
  "name": "songscan-mvp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "build:production": "node scripts/prepare-deploy.mjs && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-songscan --config firebase.test.json --only firestore \"node --test tests/firestore.test.mjs\"",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm --prefix functions test && npm --prefix functions run build",
    "deploy": "node scripts/deploy.mjs",
    "deploy:web": "node scripts/deploy.mjs --web-only",
    "format": "prettier --write src functions/src scripts tests *.json *.ts .github/workflows/*.yml"
  },
  "dependencies": {
    "firebase": "12.12.0",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.58.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
